BOT_TOKEN=your_main_bot_token
SHOP_ID=1234567
SECRET_KEY=live_token
BOT_URL=https://t.me/your_main_bot

TEST_BOT_TOKEN=your_test_bot_token
TEST_SHOP_ID=test_yookasssa_token
TEST_SECRET_KEY=yookassa_secret_key_test
TEST_BOT_URL=https://t.me/your_test_bot

ADMIN_CHAT_ID=

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=

# =========================================================================
# ВЫБОР КАССЫ
# =========================================================================
# "robokassa" (по умолчанию) | "alfa" (Альфа напрямую) | "yookassa" (спящий режим).
PAYMENT_PROVIDER=robokassa

# --- Локальный aiohttp-сервер для callback'ов (общий для всех касс, за nginx+HTTPS) ---
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# =========================================================================
# ROBOKASSA (активная касса)
# =========================================================================
# Идентификатор магазина (MerchantLogin) из ЛК Robokassa.
ROBOKASSA_MERCHANT_LOGIN=
# Пароль #1 (подпись создания платежа) и Пароль #2 (проверка подписи ResultURL).
# В тестовом режиме (ROBOKASSA_IS_TEST=True) укажи ТЕСТОВЫЕ Пароль#1/#2 из ЛК.
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Алгоритm хеша подписи — ДОЛЖЕН совпадать с настройкой в ЛК (по умолч. md5).
ROBOKASSA_HASH_ALGO=md5
# Тестовый режим (IsTest=1). Для боя — False.
ROBOKASSA_IS_TEST=False
# ResultURL: этот адрес (https://<домен>/robokassa/result) прописывается в ЛК Robokassa.
ROBOKASSA_RESULT_PATH=/robokassa/result
# Фискализация 54-ФЗ через Robokassa. Если в ЛК включена — поставь True (иначе чек
# не сформируется). Ставку/признаки сверь с ЛК.
ROBOKASSA_FISCAL=False
ROBOKASSA_TAX=none                 # none/vat0/vat10/vat20/…
ROBOKASSA_PAYMENT_METHOD=full_payment
ROBOKASSA_PAYMENT_OBJECT=service
# Система налогообложения: osn / usn_income / usn_income_outcome / envd / esn / patent.
# Пусто — берётся значение по умолчанию из ЛК Robokassa.
ROBOKASSA_SNO=
# Email получателя чека (в подпись не входит). Пусто — Robokassa спросит на форме.
ROBOKASSA_EMAIL=

# =========================================================================
# АЛЬФА-БАНК (интернет-эквайринг, «Платёжный шлюз»)
# =========================================================================
# База REST API (оканчивается на /payment/rest/):
#   боевой:   https://pay.alfabank.ru/payment/rest/
#   тестовый: https://alfa.rbsuat.com/payment/rest/
ALFA_API_BASE=https://pay.alfabank.ru/payment/rest/
# Аутентификация — ЛИБО токен, ЛИБО логин+пароль (выдаёт Альфа при подключении).
ALFA_TOKEN=
ALFA_USERNAME=
ALFA_PASSWORD=
# Куда вернуть клиента после оплаты (по умолчанию берётся BOT_URL).
ALFA_RETURN_URL=
ALFA_FAIL_URL=
# Валюта ISO 4217 (643 = RUB).
ALFA_CURRENCY=643
# Путь callback-эндпоинта — этот URL (https://домен/alfabank/callback) прописывается
# в ЛК Альфы в разделе Callback-уведомления.
ALFA_WEBHOOK_PATH=/alfabank/callback
# Callback-токен для проверки контрольной суммы (симметричная криптография).
# Пусто — уведомления без контрольной суммы (оплата всё равно перепроверяется
# серверным запросом getOrderStatusExtended). Задан — дополнительно сверяем HMAC-SHA256.
ALFA_CALLBACK_TOKEN=
# Фискализация 54-ФЗ. По умолчанию False — если Альфа фискализирует на своей стороне
# (ОФД). Включайте True только сверив схему orderBundle и ставку НДС с банком.
ALFA_FISCAL=False
ALFA_RECEIPT_EMAIL=
ALFA_TAX_TYPE=0
ALFA_MEASURE=шт

# =========================================================================
# ЮKassa (СПЯЩИЙ РЕЖИМ — используется только при PAYMENT_PROVIDER=yookassa)
# =========================================================================
# Секретный путь эндпоинта — этот же URL прописывается в кабинете ЮKassa.
WEBHOOK_PATH=/yookassa/webhook
# Необязательно: переопределить список доверенных IP/CIDR ЮKassa (через запятую).
# По умолчанию используется официальный список из кода.
YOOKASSA_ALLOWED_IPS=
# Apps Script менеджера: сюда бот пересылает сайтовые уведомления (оплаты с email
# в metadata). Тот же /exec, что и форма на сайте постит для создания платежа.
MANAGER_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx31CKDmNpq6DJVIUoS6AWBoFkdc2iMqUcX5vyCxA_ypgX3AtUTBRGbx_wH7xhpb9p3HQ/exec