TEST_MODE=False
BOT_TOKEN=replace_with_production_bot_token
TEST_BOT_TOKEN=
BOT_URL=https://t.me/your_bot_username
TEST_BOT_URL=
ADMIN_CHAT_ID=123456789
ADMIN_IDS=123456789

# Only bot-local state: FSM, schedules, file_id cache and API delivery receipts.
SQLITE_PATH=data/appstore_bot.sqlite3
API_DELIVERY_LEASE_SECONDS=120

# Signed API -> bot events. Publish only this path through HTTPS reverse proxy.
TWO_PAY_API_WEBHOOK_HOST=127.0.0.1
TWO_PAY_API_WEBHOOK_PORT=8081
TWO_PAY_API_WEBHOOK_PATH=/internal/2pay/events
TWO_PAY_API_WEBHOOK_TOKEN=replace_with_shared_api_to_bot_secret
TWO_PAY_API_WEBHOOK_MAX_AGE_SECONDS=300

# Private bot -> API calls. Values must match the corresponding API settings.
TWO_PAY_API_BASE_URL=https://api.2pay.money
TWO_PAY_API_INGEST_TOKEN=replace_with_bot_ingest_api_token
TWO_PAY_API_AUDIENCE_TOKEN=replace_with_bot_audience_api_token
TWO_PAY_API_TIMEOUT_SECONDS=10
TWO_PAY_API_START_TIMEOUT_SECONDS=3
TWO_PAY_API_INVENTORY_REFRESH_TIMEOUT_SECONDS=120
TWO_PAY_API_DEEP_LINK_URL=https://api.2pay.money/v1/bot/deep-links
TWO_PAY_API_DEEP_LINK_TIMEOUT_SECONDS=5
