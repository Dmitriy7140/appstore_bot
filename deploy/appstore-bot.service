[Unit]
Description=App Store Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/appstore_bot
Environment=PYTHONUNBUFFERED=1
Environment=SQLITE_PATH=/var/lib/appstore-bot/appstore_bot.sqlite3
StateDirectory=appstore-bot
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/appstore_bot/.venv/bin/python /opt/appstore_bot/main.py
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
