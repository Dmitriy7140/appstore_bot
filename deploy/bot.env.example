# The bot uses long polling, so it does not need a public port or a webhook URL.
TEST_MODE=False
BOT_TOKEN=replace_with_the_production_bot_token
BOT_URL=https://t.me/your_bot_username
ADMIN_CHAT_ID=123456789
ADMIN_IDS=123456789

# The PostgreSQL container is bound to localhost only.
DB_HOST=127.0.0.1
DB_NAME=appstore_bot
DB_USER=bot
DB_PASSWORD=replace_with_the_same_password_as_in_.db.env

# Direct payment providers are deliberately disabled. Do not put merchant,
# bank, or YooKassa credentials into this bot's environment.
PAYMENT_PROVIDER=disabled
