# Telegram updates use long polling. The separate listener below receives only
# signed payment/operations events from 2PAY API; put it behind HTTPS proxy.
TEST_MODE=False
BOT_TOKEN=replace_with_the_production_bot_token
BOT_URL=https://t.me/your_bot_username
ADMIN_CHAT_ID=123456789
ADMIN_IDS=123456789
SQLITE_PATH=/var/lib/appstore-bot/appstore_bot.sqlite3
API_DELIVERY_LEASE_SECONDS=120

# Keep this listener private behind Caddy/nginx when possible. The value must
# exactly match BOT_WEBHOOK_TOKEN in the API environment; it is not a Bot token.
TWO_PAY_API_WEBHOOK_HOST=127.0.0.1
TWO_PAY_API_WEBHOOK_PORT=8081
TWO_PAY_API_WEBHOOK_PATH=/internal/2pay/events
TWO_PAY_API_WEBHOOK_TOKEN=replace_with_a_long_random_shared_secret
TWO_PAY_API_WEBHOOK_MAX_AGE_SECONDS=300
TWO_PAY_API_BASE_URL=https://api.2pay.money
TWO_PAY_API_DEEP_LINK_URL=https://api.2pay.money/v1/bot/deep-links
TWO_PAY_API_INGEST_TOKEN=replace_with_a_separate_bot_to_api_secret
TWO_PAY_API_AUDIENCE_TOKEN=replace_with_the_audience_read_token
TWO_PAY_API_TIMEOUT_SECONDS=10
TWO_PAY_API_START_TIMEOUT_SECONDS=3
TWO_PAY_API_DEEP_LINK_TIMEOUT_SECONDS=5
